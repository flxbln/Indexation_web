from inverted_index import tokenize
#from utils.url_parser import enrich_documents

def build_positional_index(documents, field):
    positional_index = {}

    for doc in documents:
        doc_id = doc["product_id"]
        tokens = tokenize(doc.get(field, ""))

        for position, token in enumerate(tokens):
            positional_index.setdefault(token, {})
            positional_index[token].setdefault(doc_id, [])
            positional_index[token][doc_id].append(position)

    return positional_index
